# 服务端配置以 apps/server/config.toml 为准（参考 config.example.toml）。
# 这里的环境变量用于临时覆盖单项，优先级高于 TOML 文件。
# RECIPE_CONFIG=apps/server/config.toml
RECIPE_HOST=127.0.0.1
RECIPE_PORT=8080
RECIPE_MOCK_URL=http://127.0.0.1:3101
RECIPE_TIMEOUT=5s
# Optional future persistence; the current read pipeline requires no database.
# RECIPE_DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/recipebody?sslmode=disable
MOCK_PORT=3101

# 机台数据同步：SMB 公盘 \\10.128.0.21\d
# Windows 默认使用上述 UNC 路径，并复用运行用户的系统登录凭据。
# Linux/macOS 必须先挂载 SMB，再取消注释并填写挂载后的机台目录。
# 如果机台文件位于共享盘的子目录，请指向该子目录（直接子目录应为机台编号）。
# SMB_SOURCE_DIR=/mnt/recipe-share
# MACHINE_DATA_DIR=machine-data

# 日志：等级 debug|info|warn|error；输出 stdout|file|both；目录与归档保留份数
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_DEST=both
LOG_DIR=logs
LOG_ROTATE_MB=10
LOG_KEEP=5

# 仅容器部署需要：监听 0.0.0.0 才能被其他容器访问；本机开发保持默认回环地址
# MOCK_HOST=0.0.0.0
